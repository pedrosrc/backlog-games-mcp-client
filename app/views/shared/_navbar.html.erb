<header class="border-b border-slate-200 bg-white">
  <nav class="mx-auto flex max-w-4xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
    <%= link_to root_path, class: "flex items-center gap-2 text-base font-semibold text-slate-900" do %>
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-indigo-600 text-sm text-white" aria-hidden="true">B</span>
      Backlog Games
    <% end %>

    <div class="flex flex-1 items-center gap-1 text-sm">
      <% [ [ "Assistant", root_path ], [ "Search", games_path ], [ "My backlog", backlog_path ], [ "Recommendations", recommendations_path ] ].each do |label, path, *aliases| %>
        <% active = current_page?(path) || aliases.any? { |a| current_page?(a) } %>
        <%= link_to label, path, "aria-current": (active ? "page" : nil),
              class: "rounded-md px-3 py-1.5 font-medium #{active ? "bg-indigo-50 text-indigo-700" : "text-slate-600 hover:bg-slate-100 hover:text-slate-900"}" %>
      <% end %>
    </div>

    <div class="flex items-center gap-3 text-sm">
      <span class="hidden text-slate-500 sm:inline"><%= Current.user.name %></span>
      <%= button_to "Sign out", session_path, method: :delete, class: "btn-secondary btn-sm" %>
    </div>
  </nav>
</header>
