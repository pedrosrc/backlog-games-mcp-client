<div class="card">
  <h1 class="text-2xl font-semibold tracking-tight">Update your password</h1>

  <%= form_with url: password_path(params[:token]), method: :put, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :password, "New password", class: "label" %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
    </div>
    <div>
      <%= form.label :password_confirmation, "Repeat new password", class: "label" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
    </div>
    <%= form.submit "Save", class: "btn-primary w-full" %>
  <% end %>
</div>
