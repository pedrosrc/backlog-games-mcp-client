<div class="card">
  <h1 class="text-2xl font-semibold tracking-tight">Forgot your password?</h1>
  <p class="mt-1 text-sm text-slate-500">We'll email you a link to reset it.</p>

  <%= form_with url: passwords_path, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %>
    </div>
    <%= form.submit "Email reset instructions", class: "btn-primary w-full" %>
  <% end %>

  <p class="mt-6 text-center text-sm"><%= link_to "Back to sign in", new_session_path, class: "link" %></p>
</div>
