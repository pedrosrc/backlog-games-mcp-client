DEV_POSTGRES_HOST=localhost
DEV_POSTGRES_USER=postgres
DEV_POSTGRES_PASSWORD=secret

# URL of the backlog-games-mcp-server MCP endpoint (Streamable HTTP)
MCP_SERVER_URL=http://localhost:3001/mcp
# Optional bearer token sent to the MCP server
MCP_SERVER_TOKEN=

# Gemini API (used by the assistant on the home page)
GEMINI_API_KEY=
# Optional, defaults to gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash
